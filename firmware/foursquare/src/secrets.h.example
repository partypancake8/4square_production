#pragma once
// secrets.h.example, copy this file to secrets.h (same directory) and fill it
// in. secrets.h is gitignored and must never be committed.
//
// A DEMO build (-DDEMO_BUILD) has no radio and does not read this file at all.
// A full build needs it: firmware C has no captive portal and joins the network
// named here.
//
// Two rules that keep credentials out of the built image when they are not
// needed, and that the credential sweep in tools/secretsweep depends on:
//
//   * `static const char *const`, internal linkage, so an unreferenced
//     credential is dropped by the linker rather than merely unused.
//   * Everything sits inside `#ifndef DEMO_BUILD`, next to its only callers.
//   * The OTA password is never compiled in as plaintext. ArduinoOTA compares
//     SHA256 digests, so the image only needs the digest:
//         echo -n 'your-ota-password' | sha256sum
//     and `espota.py -a your-ota-password` still authenticates against it.
//   * tools/secretsweep/literals.sh parses NAME = "VALUE" on ONE line, so keep
//     each value on a single line.

// ---- WiFi ------------------------------------------------------------------
// Two networks are tried in turn. If you only have one, put the same SSID and
// password in both pairs.
#ifndef DEMO_BUILD
static const char *const WIFI_SSID  = "your-wifi-ssid";
static const char *const WIFI_PASS  = "your-wifi-password";
static const char *const WIFI_SSID2 = "your-second-wifi-ssid";
static const char *const WIFI_PASS2 = "your-second-wifi-password";
#endif

// ---- OTA -------------------------------------------------------------------
// SHA256 hex digest of the OTA password. The value below is the digest of the
// string "changeme"; replace it.
#ifndef DEMO_BUILD
static const char *const OTA_PASS_SHA256 = "057ba03d6c44104863dc7361fe4578965d1887360f90a0895882e58a6248fc86";
#endif
